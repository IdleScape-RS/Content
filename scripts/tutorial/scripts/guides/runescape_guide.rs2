[opnpc1,newbie_basics_instructor]
// Idlescape: there is no tutorial, so the guide explains the idle loop instead.
~chatnpc("<p,neutral>Welcome to Idlescape. You are in the starting hall, and this is where|your character will spend most of its time.");
~chatnpc("<p,neutral>Click a tree once and your character keeps chopping. Logs stack in|your pack, so the work carries on while you are logged in.");
~chatnpc("<p,neutral>Bring the logs back here and I will buy them. Use the Trade option,|then pick Sell 1, Sell 5, Sell 10 or Sell X.");
~chatnpc("<p,neutral>Spend the gold on a better axe. Better axes chop faster, and a|tinderbox lets you light fires to cook on.");
~chatnpc("<p,neutral>That fence to the south stays shut until you reach 300 total level.|Chop, fish, cook and burn until you get there.");

[proc,set_hint_newbie_basics_instructor]
if (%tutorial < ^newbie_basics_instructor_interact_with_scenery) {
    if (npc_find(0_48_48_21_35, newbie_basics_instructor, 10, 0) = true) {
        hint_npc;
    }
}
