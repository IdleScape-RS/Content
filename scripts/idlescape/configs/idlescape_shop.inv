[idlescape_shop]
// Idlescape: the only shop. Everything is bought and sold at face value (see the openshop call in
// scripts/idlescape/scripts/shop.rs2), and allstock lets players dump their logs here.
scope=shared
size=12
restock=yes
stackall=yes
allstock=yes
// Idlescape: the free bronze axe sits in the first slot, so the thing a new player wants
// is the leftmost item in the shop.
stock1=bronze_axe,10,100
stock2=iron_axe,10,100
stock3=steel_axe,10,100
stock4=black_axe,10,100
stock5=mithril_axe,10,100
stock6=adamant_axe,10,100
stock7=rune_axe,10,100
stock8=tinderbox,10,100
stock9=net,10,100
