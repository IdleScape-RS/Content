[label,levelup_attack]
//Attack level up unlock messages
switch_int(stat_base(attack)) {
    case 5 : mes("You can now wield Steel Weaponry!");
    case 10 : mes("You can now wield Black Weaponry!");
    case 20 : mes("You can now wield Mithril Weaponry!");
    case 30 : mes("You can now wield Adamant Weaponry!");
    case 40 : mes("You can now wield Rune Weaponry!");
    case 60 : mes("Members can now wield Dragon Weaponry!"); //imgur.com/VfAYlr7
}
