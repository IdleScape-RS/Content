    case 34 : mes("You can now make @dbl@Agility Potions@bla@.");
    case 38 : mes("You can now make @dbl@Prayer Restore Potions@bla@.");
    case 40 : mes("You can now identify @dbl@Irit Leaf@bla@.");
    case 45 : mes("You can now make @dbl@Super Attack Potions@bla@.");
    case 48 : mes("You can now make @dbl@Super Antipoison Potions@bla@. You can now identify @dbl@Avantoe@bla@.");
    case 50 : mes("You can now make @dbl@Fishing Potions@bla@.");
    case 52 : mes("You can now make @dbl@Super Energy Potions@bla@.");
    case 54 : mes("You can now identify @dbl@Kwuarm@bla@.");
    case 55 : mes("You can now make @dbl@Super Strength Potions@bla@.");
    case 60 : mes("You can now make @dbl@Weapon Poisons."); //imgur.com/dLoBair
    case 63 : mes("You can now make @dbl@Super Restore Potions@bla@.");
    case 65 : mes("You can now identify @dbl@Cadantine@bla@.");
