[label,levelup_ranged]
//Ranged level up unlock messages
switch_int(stat_base(ranged)) {
    case 5  : mes("You can now wield @dbl@Oak Bows@bla@ and members can wield @dbl@Steel Throwing Weapons@bla@.");
    case 10 : mes("Members can now wield @dbl@Black Throwing Weapons@bla@.");
    case 20 : mes("You can now wield @dbl@Willow Bows@bla@ and wear @dbl@Studded @dbl@Armour@bla@ and @dbl@Coifs@bla@, and members can now wield @dbl@Mithril Throwing Weapons@bla@.");
    case 30 : mes("You can now wield @dbl@Maple Bows@bla@ and members can wield @dbl@Adamant Throwing Weapons@bla@.");
    case 40 : mes("You can now wear @dbl@Green Dragonhide armour@bla@. Members can wield @dbl@Yew Bows@bla@ & @dbl@Rune Throwing Weapons @bla@and wear @dbl@ranger boots@bla@ and the @dbl@Robin Hood hat@bla@."); // https://i.imgur.com/wgcI7oD.png (2006)
    case 50 : mes("Members can now wield @dbl@Magic Bows@bla@ and wear @dbl@Blue Dragonhide armour@bla@."); // https://runescapenonbiri.up.seesaa.net/image/rangup.jpg (2005)
    case 60 : mes("Members can now wear @dbl@Red Dragonhide armour@bla@."); // https://i.imgur.com/jlpLjht.png (2005)
    case 70 : mes("Members can now wear @dbl@Black Dragonhide armour@bla@."); // https://i.imgur.com/qeFzWO7.png (2005)
}
