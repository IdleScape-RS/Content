[label,levelup_ranged]
//Ranged level up unlock messages
switch_int(stat_base(ranged)) {
    case 5  : mes("You can now wield Oak Bows and members can wield Steel Throwing Weapons.");
    case 10 : mes("Members can now wield Black Throwing Weapons.");
    case 20 : mes("You can now wield Willow Bows and wear Studded Armour and Coifs, and members can now wield Mithril Throwing Weapons.");
    case 30 : mes("You can now wield Maple Bows and members can wield Adamant Throwing Weapons.");
    case 40 : mes("You can now wear Green Dragonhide armour. Members can wield Yew Bows & Rune Throwing Weapons and wear ranger boots and the Robin Hood hat."); // https://i.imgur.com/wgcI7oD.png (2006)
    case 50 : mes("Members can now wield Magic Bows and wear Blue Dragonhide armour."); // https://runescapenonbiri.up.seesaa.net/image/rangup.jpg (2005)
    case 60 : mes("Members can now wear Red Dragonhide armour."); // https://i.imgur.com/jlpLjht.png (2005)
    case 70 : mes("Members can now wear Black Dragonhide armour."); // https://i.imgur.com/qeFzWO7.png (2005)
}
