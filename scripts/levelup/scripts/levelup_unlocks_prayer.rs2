[label,levelup_prayer]
//Prayer level up unlock messages
//screenshots as early as 2006 show blue exclamation marks
switch_int(stat_base(prayer)) {
    case 4 : mes("You can now use the Prayer Burst of Strength!");
    case 7 : mes("You can now use the Prayer Clarity of Thought!");
    case 10 : mes("You can now use the Prayer Rock Skin!");
    case 13 : mes("You can now use the Prayer Superhuman Strength!");
    case 16 : mes("You can now use the Prayer Improved Reflexes!");
    case 19 : mes("You can now use the Prayer Rapid Restore!");
    case 22 : mes("You can now use the Prayer Rapid Heal!");
    case 25 : mes("You can now use the Prayer Protect Items!");
    case 28 : mes("You can now use the Prayer Steel Skin!");
    case 31 : mes("You can now use the Prayer Ultimate Strength and you can enter the Monastery");
    case 34 : mes("You can now use the Prayer Incredible Reflexes!");
    case 37 : mes("You can now use the Prayer Protect From Magic!");
    case 40 : mes("You can now use the Prayer Protect From Missiles!");
    case 43 : mes("You can now use the Prayer Protect From Melee!");
}
