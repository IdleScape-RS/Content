[label,levelup_cooking]
//Cooking level up unlock messages
switch_int(stat_base(cooking)) {
    case 5 : mes("You can now cook @dbl@Herring@bla@.");
    case 10 : mes("You can now cook @dbl@Redberry Pies@bla@. Members can cook @dbl@Mackerel@bla@.");
    case 12 : mes("Members can now cook @dbl@thin snail@bla@.");
    case 15 : mes("You can now cook @dbl@Trout@bla@.");
    case 17 : mes("Members can now cook @dbl@lean snail@bla@.");
    case 18 : mes("Members can now cook @dbl@Cod@bla@.");
    case 20 : mes("You can now cook @dbl@Meat Pies@bla@ and @dbl@Pike@bla@.");
    case 22 : mes("Members can now cook @dbl@fat snail@bla@.");
    case 25 : mes("You can now cook @dbl@Stews@bla@ and @dbl@Salmon@bla@.");
    case 28 : mes("Members can now cook @dbl@slimey eels@bla@.");
    case 30 : mes("You can now cook @dbl@Apple Pies@bla@ and @dbl@Tuna@bla@.");
    case 32 : mes("You are now qualified to enter the prestigious @dbl@Chefs' Guild@bla@.");
    case 35 : mes("You can now cook @dbl@Pizzas@bla@ and @dbl@Wine@bla@.");
    case 40 : mes("You can now cook @dbl@Cakes@bla@ and @dbl@Lobsters@bla@.");
    case 43 : mes("Members can now cook @dbl@Bass@bla@.");
    case 45 : mes("You can now cook @dbl@Meat Pizzas@bla@ and @dbl@Swordfish@bla@.");
    case 50 : mes("You can now cook @dbl@Chocolate Cakes@bla@.");
    case 53 : mes("Members can now cook @dbl@Lava Eel@bla@.");
    case 55 : mes("You can now cook @dbl@Anchovy Pizza@bla@.");
    case 58 : mes("Members can now cook @dbl@Pitta Bread@bla@.");
    case 60 : mes("Members can now cook @dbl@Curry@bla@.");
    case 65 : mes("Members can now cook @dbl@Pineapple Pizza@bla@.");
    case 80 : mes("Members can now cook @dbl@Shark@bla@.");
    case 82 : mes("Members can now cook @dbl@Sea Turtle@bla@.");
    case 91 : mes("Members can now cook @dbl@Manta Rays@bla@.");
}
