[label,levelup_woodcutting]
//Woodcutting level up unlock messages
switch_int(stat_base(woodcutting)) {
    // axe requirements were not a thing originally, added mid-2005 maybe?
    case 15 : mes("You can now cut down @dbl@Oak Trees.");
    case 30 : mes("You can now cut down @dbl@Willow Trees.");
    case 40 : mes("@dbl@~ This is one of the requirements of the @dre@FREMENNIK TRIALS@dbl@. @dbl@~");
    case 45 : mes("You can now cut down @dbl@Maple Trees.");
    case 60 : mes("You can now cut down @dbl@Yew Trees.");
    case 75 : mes("Members can now cut down @dbl@Magic Trees.");
}
