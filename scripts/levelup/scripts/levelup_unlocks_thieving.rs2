[label,levelup_thieving]
//Thieving level up unlock messages
switch_int(stat_base(thieving)) {
    case 5 : mes("You can now steal from Cake Stalls, Tea Stalls, Crafting Stalls and Monkey Food Stalls!");
    case 10 : mes("You can now pickpocket from Farmers!");
    case 13 : mes("You can now steal from certain chests in Ardougne and the Wilderness!");
    // case 15 : mes("You can now pickpocket from HAM followers!");
    case 20 : mes("You can now steal from Silk Stalls!");
    // case 22 : mes("You can now steal from Wine Stalls!");
    case 25 : mes("You can now pickpocket from Warriors!");
    case 32 : mes("You can now pickpocket from Rogues!");
    case 35 : mes("You can now steal from Fur Stalls!");
    // case 38 : mes("You can now pickpocket from Master Farmers!");
    case 40 : mes("You can now pickpocket from City Guards!");
    case 42 : mes("You can now steal from Fish Stalls!");
    case 45 : mes("You can now pickpocket from Fremenniks!");
    case 43 : mes("You can now steal from certain chests upstairs in Ardougne!");
    case 47 : mes("You can now steal from certain chests in Hemenster with the aid of a lockpick!");
    case 50 : mes("You can now steal from Silver Stalls!");
    case 55 : mes("You can now pickpocket from Knights of Ardougne!");
    case 59 : mes("You can now steal from chests under the Chaos Druid Tower near Ardougne!");
    case 65 : mes("You can now steal from Spice Stalls, Magic Stalls and Scimitar Stalls and pickpocket from Watchmen!");
    case 70 : mes("You can now pickpocket from Paladins!");
    case 72 : mes("You can now steal from certain chests in the castle in Ardougne!");
    case 75 : mes("You can now steal from Gem Stalls and pickpocket from Gnomes!");
    case 80 : mes("You can now pickpocket from Heroes!");
}
